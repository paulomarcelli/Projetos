# Copie para .env e ajuste. Nunca envie o .env ao repositório.
# Os valores abaixo são demonstrativos: troque as senhas e use sua própria chave.

# --- Aplicação ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- Banco de dados (PostgreSQL + pgvector) ---
# Usadas pelo docker-compose para criar o banco. A senha deve ser a mesma da DATABASE_URL.
POSTGRES_USER=iris
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=iris
POSTGRES_PORT=5432

# Usada pela aplicação e pelo Alembic (driver psycopg 3).
DATABASE_URL=postgresql+psycopg://iris:troque-esta-senha@localhost:5432/iris
DB_CONNECT_TIMEOUT_SECONDS=3

# --- Modelo de linguagem (OpenAI) ---
OPENAI_API_KEY=coloque-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
# Opcional: endereço de um serviço compatível com a API da OpenAI.
# OPENAI_BASE_URL=

# --- Ingestão de documentos (Fase 2) ---
# Diretório persistente dos PDFs (fora do git). Relativo à pasta onde a API é iniciada.
STORAGE_DIR=data/documents
MAX_UPLOAD_MB=50               # tamanho máximo de cada PDF, em MB
MAX_PDF_PAGES=2000             # PDFs com mais páginas são recusados
