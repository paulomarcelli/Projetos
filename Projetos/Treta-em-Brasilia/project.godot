; Treta em Brasília — jogo de luta 2D de paródia política (Godot 4.3)

config_version=5

[application]

config/name="Brasília Kombat"
config/description="Jogo de luta 2D de paródia com políticos e memes do Brasil."
run/main_scene="res://cenas/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Controles="*res://scripts/controles.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=3

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.1, 1)
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[input_devices]

pointing/emulate_mouse_from_touch=true
