# Serviços (docker compose up -d)
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha

# Modelo de embedding (baixado na primeira execução)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Modelo de linguagem do motor prospectivo (OpenAI). Sem chave, o motor roda no modo determinístico.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Revendedor compatível com a OpenAI: o endereço base termina em /v1 (ex.: https://revendedor.exemplo/v1)
OPENAI_BASE_URL=

# Persistência das investigações
FREYA_DB_PATH=data/freya.db

# Coleta (marvel.com): intervalo entre requisições, em segundos
COLETA_INTERVALO=2.0
