      },
      "mov/rotulo-entrada": {
        "quadros": 8,
        "curva": "spring({damping: 12, mass: 0.6, stiffness: 180})",
        "uso": "escala 0 -> 1.08 -> 1"
      },
      "mov/rotulo-saida": {
        "quadros": 6,
        "curva": "cubic-bezier(0.4, 0, 1, 1)",
        "uso": "escala 1 -> 0.9, opacidade -> 0"
      },
      "mov/seta-entrada": {
        "quadros": 10,
        "curva": "cubic-bezier(0, 0, 0.2, 1)",
        "uso": "cresce do pé à ponta; depois oscila 6 px a cada 1,2 s"
      },
      "mov/camera-transicao": {
        "quadros": "30 a 45",
        "curva": "cubic-bezier(0.65, 0, 0.35, 1)",
        "uso": "passagem entre trechos, sem corte"
      },
      "mov/camera-deriva": {
        "quadros": "o trecho todo",
        "curva": "linear",
        "uso": "a câmera avança 3% a 5% dentro do trecho"
      },
      "mov/modo-cor": {
        "quadros": 45,
        "curva": "linear",
        "uso": "mistura de um modo de cor para o outro"
      },
      "mov/lua-some": {
        "quadros": 24,
        "curva": "ease-in",
        "uso": "Lua: escala 1 -> 0.96 e opacidade -> 0"
      },
      "mov/fechamento": {
        "quadros": 12,
        "curva": "cubic-bezier(0.65, 0, 0.35, 1)",
        "uso": "círculo laranja cresce a partir da Lua"
      }
    }
  },
