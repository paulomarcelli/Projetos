# Copie para .env (ou defina no terminal). Nunca envie o .env para o GitHub.
# Chave do Google AI Studio (obrigatória para o chat responder com IA):
GEMINI_API_KEY=coloque-sua-chave-aqui

# Opcional — OpenAI como modelo principal (o Gemini vira reserva se ela falhar):
# OPENAI_API_KEY=coloque-a-chave-da-openai-aqui
# LUNA_PROVEDOR=gemini          # força só o Gemini, mesmo com chave da OpenAI
# LUNA_OPENAI_MODELO=gpt-4o-mini

# Opcionais — modelo de conversa:
# LUNA_MODELO=gemini-3.6-flash
# LUNA_PENSAMENTO=low

# Opcionais — RAG (biblioteca de pesquisa em conhecimento/):
# LUNA_RAG=1                    # 0 desliga o RAG (o chat continua funcionando)
# LUNA_RAG_DIR=./conhecimento   # pasta da biblioteca
# LUNA_RAG_TOP_K=3              # máximo de trechos por resposta
# LUNA_RAG_MAX_CARACTERES=3600  # teto de caracteres somados dos trechos
# LUNA_RAG_DENSO=0              # 1 liga a busca híbrida (BM25 + embeddings; usa a cota do Gemini)
# LUNA_EMBEDDING_MODELO=gemini-embedding-001
# LUNA_RAG_SIM_ALTA=0.675       # similaridade a partir da qual os embeddings sozinhos bastam
# LUNA_RAG_SIM_MEDIA=0.64       # faixa de borda: exige também uma palavra em comum
#   (calibrados para gemini-embedding-001 com tests/calibrar_busca_densa.py; recalibre ao trocar de modelo)

# Opcional — conversa por voz em tempo real (OpenAI Realtime, WebRTC):
# OPENAI_REALTIME_API_KEY=chave-oficial-da-openai   # chaves de revenda não têm Realtime
# LUNA_REALTIME_MODELO=gpt-realtime-2.1
# LUNA_REALTIME_VOZ=marin
# LUNA_VOZ_TEMPO_REAL=0         # desliga e volta para a voz do navegador

# Opcional — frontend publicado em outro endereço (ex.: GitHub Pages):
# LUNA_ORIGENS_PERMITIDAS=https://paulomarcelli.github.io
