# Copie para backend/.env e preencha. NUNCA versione o arquivo .env.
# Sem IA e busca configuradas, o ATLAS roda em MODO DEMONSTRATIVO (sem pesquisa real, nada marcado como fato).

# ---------------------------------------------------------------- escolha dos provedores
# IA:    auto (Gemini se houver chave) | gemini | ollama | openai | demo
# Busca: auto (Tavily se houver chave) | tavily | gdelt | demo
#
# Opção 100% gratuita e sem chaves:
#   1. instale o Ollama (https://ollama.com) e rode: ollama pull qwen2.5:7b
#   2. ATLAS_PROVEDOR_IA=ollama  e  ATLAS_PROVEDOR_BUSCA=gdelt
ATLAS_PROVEDOR_IA=auto
ATLAS_PROVEDOR_BUSCA=auto

# Ollama (IA local: sem chave, sem cota, os dados não saem da máquina)
ATLAS_OLLAMA_URL=http://localhost:11434
ATLAS_OLLAMA_MODEL=qwen2.5:7b
ATLAS_OLLAMA_TIMEOUT_S=300

# Qualquer API compatível com a da OpenAI (Groq, OpenRouter, Mistral, LM Studio…)
# Ex.: ATLAS_OPENAI_BASE_URL=https://api.groq.com/openai/v1
ATLAS_OPENAI_BASE_URL=
ATLAS_OPENAI_MODEL=
ATLAS_OPENAI_API_KEY=

# GDELT (busca de notícias) não precisa de chave.

# Google Gemini (plano gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
ATLAS_GEMINI_MODEL=gemini-3.6-flash

# Tavily (pesquisa na web, plano gratuito): https://app.tavily.com
TAVILY_API_KEY=

# auto = usa as chaves que existirem; demo = força o modo demonstrativo
ATLAS_MODO=auto
ATLAS_DB=./atlas.db

# Limites de proteção de cota (por simulação / por dia)
ATLAS_MAX_REVISOES=2
ATLAS_MAX_BUSCAS=4
ATLAS_RESULTADOS_POR_BUSCA=4
ATLAS_MAX_CHAMADAS_LLM=8
ATLAS_MAX_SIMULACOES_DIA=40
ATLAS_TIMEOUT_S=45
ATLAS_TENTATIVAS_API=2
ATLAS_CACHE_HORAS=24

# Origens autorizadas a chamar a API (frontend)
ATLAS_CORS=http://localhost:5173,http://127.0.0.1:5173
