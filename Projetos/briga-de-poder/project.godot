; Engine configuration file.
; BRIGA DE PODER — configuração do projeto (Godot 4.4, renderer Compatibility, foco Web).

config_version=5

[application]

config/name="Briga de Poder"
config/description="Jogo de luta 2D satírico, jogável no navegador (desktop e celular)."
config/version="0.2.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.051, 0.039, 0.098, 1)
boot_splash/show_image=false
config/icon="res://assets/ui/icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

PlatformInfo="*res://scripts/platform/platform_info.gd"
Settings="*res://scripts/core/settings.gd"
InputDetector="*res://scripts/input/input_detector.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
SceneManager="*res://scripts/core/scene_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[gui]

theme/custom="res://assets/ui/theme.tres"
common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.051, 0.039, 0.098, 1)
anti_aliasing/quality/msaa_2d=0

[debug]

gdscript/warnings/integer_division=0
